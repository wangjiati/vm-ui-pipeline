{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/wangjiati/vm-ui-pipeline/schema/pipeline.schema.json",
  "title": "VM UI Pipeline 配置",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "artifact", "runner", "suite", "launcher", "vms"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "guestRoot": {
      "type": "string",
      "pattern": "^[A-Za-z]:\\\\",
      "description": "客户机内用于投放文件的绝对目录，默认 C:\\VmUiPipeline。"
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "exe"],
      "properties": {
        "path": { "type": "string", "description": "包含应用的目录或 .zip 文件。" },
        "exe": { "type": "string", "description": "相对于产物根目录的可执行文件路径。" },
        "arguments": { "type": "string", "description": "启动应用时传入的参数。" },
        "processName": { "type": "string", "description": "用于查找主窗口和清理残留进程的进程名。" }
      }
    },
    "runner": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path"],
      "properties": {
        "path": { "type": "string", "description": "VmUiPipeline.Runner.exe 的路径。" }
      }
    },
    "suite": {
      "type": "object",
      "additionalProperties": false,
      "required": ["assembly", "type"],
      "properties": {
        "assembly": { "type": "string", "description": "实现 IUiTestSuite 的测试套件程序集。" },
        "type": { "type": "string", "description": "IUiTestSuite 实现的完整类型名。" },
        "folder": { "type": "string", "description": "作为 --folder 传给套件的目录；VM 运行时必须是客户机路径。" },
        "parameters": {
          "type": "object",
          "additionalProperties": { "type": ["string", "number", "boolean"] },
          "description": "额外的 --param key=value 参数，通过 UiTestContext.Parameters 读取。"
        }
      }
    },
    "fixtures": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source", "destination"],
        "properties": {
          "source": { "type": "string", "description": "宿主机上要复制的目录。" },
          "destination": { "type": "string", "description": "客户机目标目录。" },
          "clean": { "type": "boolean", "default": true, "description": "复制前是否清空目标目录。" }
        }
      }
    },
    "launcher": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "sshcPath", "sshServerExe", "ipWhitelist"],
      "properties": {
        "type": { "const": "win-simple-ssh" },
        "sshcPath": { "type": "string", "description": "宿主机上的 SSHC.exe。" },
        "sshServerExe": { "type": "string", "description": "投放到客户机的 SSHServer.exe。" },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535, "default": 22222 },
        "ipWhitelist": { "type": "array", "items": { "type": "string" }, "minItems": 1, "description": "客户机服务允许连接的 IP 列表。" },
        "vmrunPath": { "type": "string", "description": "vmrun.exe 的路径，用于快照回滚。" }
      }
    },
    "vms": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name"],
        "properties": {
          "name": { "type": "string", "description": "VM 的稳定标识。" },
          "address": { "type": "string", "description": "宿主机可访问的 IP 地址或主机名。" },
          "user": { "type": "string", "description": "客户机本地管理员账户。" },
          "passwordEnv": { "type": "string", "description": "保存密码的环境变量名。" },
          "shareName": { "type": "string", "default": "c$", "description": "SMB 管理共享名。" },
          "vmx": { "type": "string", "description": "用于快照回滚的 VMX 路径。" },
          "snapshot": { "type": "string", "description": "用于回滚的快照名。" }
        }
      }
    },
    "recording": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean", "default": false, "description": "是否启用 MP4 录屏。" },
        "ffmpegPath": { "type": "string", "description": "客户机上的 ffmpeg 路径，或 PATH 中的名称。" },
        "fps": { "type": "integer", "minimum": 1, "maximum": 60, "default": 10, "description": "录屏帧率。" }
      }
    },
    "timeoutMinutes": { "type": "integer", "minimum": 1, "default": 10, "description": "单 VM 结果等待超时（分钟）。" },
    "startupTimeoutSeconds": { "type": "integer", "minimum": 1, "default": 60, "description": "等待应用主窗口的时间（秒）。" },
    "resultsDirectory": { "type": "string", "description": "宿主机结果根目录。" }
  }
}
