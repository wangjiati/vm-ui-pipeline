{
  "$schema": "../schema/pipeline.schema.json",
  "schemaVersion": 1,
  "guestRoot": "C:\\VmUiPipeline",
  "artifact": {
    "path": "../artifacts/demo/app",
    "exe": "SampleApp.exe"
  },
  "runner": {
    "path": "../artifacts/demo/publish/VmUiPipeline.Runner.exe"
  },
  "suite": {
    "assembly": "../artifacts/demo/suite/DemoTests.dll",
    "type": "DemoTests.DemoSuite"
  },
  "launcher": {
    "type": "win-simple-ssh",
    "sshcPath": "../external/WinSimpleSSH/src/SSHClient/bin/Release/net452/SSHC.exe",
    "sshServerExe": "../external/WinSimpleSSH/src/SSHServer/bin/Release/net452/SSHServer.exe",
    "port": 22222,
    "ipWhitelist": ["192.168.221.*"]
  },
  "vms": [
    {
      "name": "win10",
      "address": "192.168.221.128",
      "user": "win10",
      "passwordEnv": "VM_WIN10_PASSWORD"
    }
  ],
  "timeoutMinutes": 5,
  "startupTimeoutSeconds": 45,
  "resultsDirectory": "../artifacts/demos"
}
